# ============================================================
#  ДентаЛюкс — конфігурація Apache
#  HTTPS · 404 · security headers · gzip · кеш
# ============================================================

# ----- Кодування за замовчуванням -----
AddDefaultCharset UTF-8

# ----- Сторінка 404 -----
ErrorDocument 404 /404.html

# ============================================================
#  Примусовий HTTPS + www -> без www (за бажанням)
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ----- Блокування службових файлів і каталогів, що починаються з крапки -----
    # Закриває .git, .claude, .gitignore, .env тощо.
    # Без цього правила заливка папки проєкту по FTP робить усю історію
    # репозиторію доступною за адресою /.git/ (див. git-dumper).
    # Виняток — /.well-known/, він потрібен для випуску SSL-сертифікатів.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule "(^|/)\." - [F,L]

    # Примусовий HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Прибрати www (розкоментуйте, якщо потрібно)
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ============================================================
#  Security headers
# ============================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Content-Security-Policy.
    # Сайт статичний: власні CSS/JS + шрифти Google. Сторонніх скриптів немає.
    # 'unsafe-inline' у style-src потрібен лише через інлайновий <style> у 404.html
    # (сторінка навмисно самодостатня). У script-src інлайн НЕ дозволено.
    # Якщо додасте аналітику (GA4) чи піксель — допишіть їхні домени сюди.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; upgrade-insecure-requests"
    # HSTS — вмикайте лише після перевірки, що HTTPS працює стабільно
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    # Прибрати зайву інформацію про сервер
    Header unset X-Powered-By
</IfModule>

# ============================================================
#  GZIP стиснення
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2 application/font-woff
</IfModule>

# ============================================================
#  Кешування у браузері
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ============================================================
#  Захист службових файлів
# ============================================================
<FilesMatch "(^\.htaccess|\.(htpasswd|ini|log|sh|bak))$">
    Require all denied
</FilesMatch>

# ----- Прибрати лістинг директорій -----
Options -Indexes
